generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String               @id @default(cuid())
  name            String
  status          String               @default("ACTIVE")
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  settings        Setting[]
  auditEvents     AuditEvent[]
  roleAssignments UserRoleAssignment[]
  vehicles        Vehicle[]
  drivers         Driver[]
  customers       Customer[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  incidents                 Incident[]
  incidentStatusHistory     IncidentStatusHistory[]
  rentalRequests  RentalRequest[]
  pricingWorksheets RentalPricingWorksheet[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  maintenanceWorkOrderStatusHistory MaintenanceWorkOrderStatusHistory[]
  vehicleSafetyBlocks  VehicleSafetyBlock[]
  clients               Client[]
  contracts             Contract[]
  employees             Employee[]
  locations             Location[]
  routes                Route[]
  routeStops            RouteStop[]
  routeSchedules        RouteSchedule[]
  bookings              Booking[]
  bookingStatusHistory  BookingStatusHistory[]
  trips                 Trip[]
  tripStatusHistory     TripStatusHistory[]
  driverEvents          DriverEvent[]
  corporateInvoices     CorporateInvoice[]
  userClientBindings    UserClientBinding[]
  passengerFeedback     PassengerFeedback[]
}

model Client {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  registrationDetails String?
  contactPerson    String?
  telephone        String?
  email            String?
  billingAddress   String?
  status           String?
  notes            String?
  archivedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contracts        Contract[]
  userBindings     UserClientBinding[]
  corporateInvoices CorporateInvoice[]
  employees        Employee[]
  routes           Route[]
  bookings         Booking[]
  trips            Trip[]

  @@unique([companyId, id])
  @@index([companyId, archivedAt, name])
}

model Location {
  id                  String    @id @default(cuid())
  companyId           String
  name                String
  latitude            Decimal?  @db.Decimal(9, 6)
  longitude           Decimal?  @db.Decimal(9, 6)
  landmarkDescription String?
  ghanaDigitalAddress String?
  notes               String?
  archivedAt          DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  originRoutes        Route[]   @relation("RouteOrigin")
  destinationRoutes   Route[]   @relation("RouteDestination")
  routeStops          RouteStop[]
  bookingPickups      Booking[] @relation("BookingPickup")
  bookingDropoffs     Booking[] @relation("BookingDropoff")

  @@unique([companyId, id])
  @@index([companyId, archivedAt, name])
}

model Route {
  id                      String    @id @default(cuid())
  companyId               String
  clientId                String
  reference               String
  name                    String
  serviceType             String?
  originLocationId        String
  destinationLocationId   String
  plannedStartTime        String?
  expectedDurationMinutes Int?
  capacityRequirement     Int?
  operatingDays           String[]
  shift                   String?
  active                  Boolean
  notes                   String?
  archivedAt              DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                  Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  originLocation          Location  @relation("RouteOrigin", fields: [companyId, originLocationId], references: [companyId, id], onDelete: Restrict)
  destinationLocation     Location  @relation("RouteDestination", fields: [companyId, destinationLocationId], references: [companyId, id], onDelete: Restrict)
  stops                   RouteStop[]
  schedules               RouteSchedule[]
  bookings                Booking[]
  trips                   Trip[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, archivedAt, name])
  @@index([companyId, clientId, archivedAt])
}

model RouteStop {
  id                   String   @id @default(cuid())
  companyId            String
  routeId              String
  locationId           String
  sequence             Int
  stopKind             String
  plannedOffsetMinutes Int?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  route                Route    @relation(fields: [companyId, routeId], references: [companyId, id], onDelete: Restrict)
  location             Location @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, routeId, sequence])
  @@index([companyId, routeId])
  @@index([companyId, locationId])
}

model RouteSchedule {
  id               String    @id @default(cuid())
  companyId        String
  routeId          String
  kind             String
  daysOfWeek       String[]
  scheduleDate     DateTime? @db.Date
  shift            String?
  plannedStartTime String?
  active           Boolean
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  route            Route     @relation(fields: [companyId, routeId], references: [companyId, id], onDelete: Restrict)
  trips            Trip[]

  @@unique([companyId, id])
  @@index([companyId, routeId, active])
}

model Employee {
  id                      String    @id @default(cuid())
  companyId               String
  clientId                String
  reference               String?
  fullName                String
  telephone               String?
  email                   String?
  homeAddress             String?
  department              String?
  workLocation            String?
  shift                   String?
  approvedPickupLocation  String?
  approvedDropoffLocation String?
  accountStatus           String?
  transportEligible       Boolean?
  accessibilityNeeds      String?
  notes                   String?
  archivedAt              DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  userId                  String?   @unique
  linkedUser              User?     @relation("PassengerAccount", fields: [userId], references: [id], onDelete: Restrict)
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                  Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  bookings                Booking[]
  passengerFeedback       PassengerFeedback[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, archivedAt, fullName])
  @@index([companyId, clientId, archivedAt])
}

model Contract {
  id                   String    @id @default(cuid())
  companyId            String
  clientId             String
  reference            String
  serviceType          String?
  startDate            DateTime? @db.Date
  endDate              DateTime? @db.Date
  renewalDate          DateTime? @db.Date
  routesAndStops       String?
  serviceDaysAndShifts String?
  vehicleRequirements  String?
  pricingModel         String?
  billingFrequency     String?
  paymentTerms         String?
  serviceLevelTargets  String?
  notes                String?
  status               String
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client               Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  statusHistory        ContractStatusHistory[]
  bookings             Booking[]
  corporateInvoices    CorporateInvoice[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, status, createdAt])
  @@index([companyId, clientId, createdAt])
  @@index([companyId, endDate])
}

model ContractStatusHistory {
  id         String   @id @default(cuid())
  companyId  String
  contractId String
  sequence   Int
  actorId    String
  fromStatus String?
  toStatus   String
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  contract   Contract @relation(fields: [companyId, contractId], references: [companyId, id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, contractId, sequence])
  @@index([companyId, contractId, createdAt])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  sessions            Session[]
  accounts            Account[]
  auditEvents         AuditEvent[]
  roleAssignments     UserRoleAssignment[] @relation("RoleAssignee")
  assignedRoleChanges UserRoleAssignment[] @relation("RoleAssignmentActor")
  rentalRequestStatusChanges RentalRequestStatusHistory[]
  contractStatusChanges ContractStatusHistory[]
  corporateInvoiceStatusChanges CorporateInvoiceStatusHistory[]
  invoicePaymentsRecorded InvoicePayment[]
  bookingStatusChanges BookingStatusHistory[]
  tripStatusChanges TripStatusHistory[]
  driverAccount     Driver?                @relation("DriverAccount")
  employeeAccount   Employee?              @relation("PassengerAccount")
  customerAccount   Customer?              @relation("CustomerAccount")
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  incidentsReported  Incident[]            @relation("IncidentReporter")
  incidentsAssigned  Incident[]            @relation("IncidentResponder")
  incidentStatusChanges IncidentStatusHistory[]
  driverEvents      DriverEvent[]
  clientBindings    UserClientBinding[]    @relation("BindingUser")
  bindingsMade      UserClientBinding[]    @relation("BindingActor")
  createdPricingWorksheets RentalPricingWorksheet[]
  createdMaintenanceWorkOrders MaintenanceWorkOrder[] @relation("WorkOrderCreator")
  maintenanceWorkOrderStatusChanges MaintenanceWorkOrderStatusHistory[]
  appliedVehicleSafetyBlocks   VehicleSafetyBlock[] @relation("SafetyBlockAppliedBy")
  releasedVehicleSafetyBlocks  VehicleSafetyBlock[] @relation("SafetyBlockReleasedBy")
}

model Role {
  code        String               @id
  name        String
  assignments UserRoleAssignment[]
  grants      RolePermission[]
}

model RolePermission {
  roleCode   String
  permission String
  scope      String
  role       Role   @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([roleCode, permission, scope])
  @@index([permission, scope])
}

model UserRoleAssignment {
  id           String    @id @default(cuid())
  userId       String
  companyId    String?
  roleCode     String
  assignedById String?
  reason       String
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  user         User      @relation("RoleAssignee", fields: [userId], references: [id], onDelete: Restrict)
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([companyId, roleCode, revokedAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  summary    Json
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Setting {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  key         String
  value       Json?
  configured  Boolean  @default(false)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedById String?

  @@unique([companyId, key])
  @@index([companyId, configured])
}

model Vehicle {
  id                        String    @id @default(cuid())
  companyId                 String
  registrationNumber        String
  make                      String
  model                     String
  category                  String
  seatCount                 Int?
  fuelType                  String?
  ownershipType             String?
  odometerValue             Decimal?  @db.Decimal(12, 2)
  odometerUnit              String?
  insuranceExpiresAt        DateTime? @db.Date
  roadworthinessExpiresAt   DateTime? @db.Date
  registrationExpiresAt     DateTime? @db.Date
  nextServiceAt             DateTime? @db.Date
  notes                     String?
  usualDriverCompanyId      String?
  usualDriverId             String?
  archivedAt                DateTime? @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(6)
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  usualDriver               Driver?   @relation("VehicleUsualDriver", fields: [usualDriverCompanyId, usualDriverId], references: [companyId, id], onDelete: Restrict)
  maintenanceWorkOrders     MaintenanceWorkOrder[]
  safetyBlocks              VehicleSafetyBlock[]
  incidents                 Incident[]
  trips                     Trip[]

  @@unique([companyId, registrationNumber])
  @@unique([companyId, id])
  @@index([companyId, archivedAt, registrationNumber])
  @@index([companyId, category])
  @@index([companyId, usualDriverId])
}

model Driver {
  id                String    @id @default(cuid())
  companyId         String
  userId            String?   @unique
  linkedUser        User?     @relation("DriverAccount", fields: [userId], references: [id], onDelete: Restrict)
  incidents          Incident[]
  fullName          String
  licenceClass      String?
  licenceExpiresAt  DateTime? @db.Date
  qualifications    String?
  availability      String?
  status            String?
  archivedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  usualVehicles     Vehicle[]  @relation("VehicleUsualDriver")
  trips             Trip[]
  events            DriverEvent[]

  @@unique([companyId, id])
  @@index([companyId, archivedAt, fullName])
  @@index([companyId, licenceExpiresAt])
}

model Customer {
  id             String    @id @default(cuid())
  companyId      String
  reference      String?
  displayName    String
  contactPerson  String?
  telephone      String?
  email          String?
  billingDetails String?
  customerType   String?
  status         String?
  notes          String?
  userId         String?   @unique
  archivedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  linkedUser     User?     @relation("CustomerAccount", fields: [userId], references: [id], onDelete: Restrict)
  rentalRequests RentalRequest[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, archivedAt, displayName])
  @@index([companyId, customerType])
}

model RentalRequest {
  id                   String                       @id @default(cuid())
  companyId            String
  customerId           String
  serviceDate          DateTime?                    @db.Date
  departureTime         String?
  returnTime            String?
  returnDate            DateTime?                    @db.Date
  durationMinutes      Int?
  pickupLocation       String?
  destination          String?
  intermediateStops    String?
  passengerCount       Int?
  luggageSpecialNeeds  String?
  purpose              String?
  requestedVehicleType String?
  driverRequirement    String?
  tripContactName      String?
  tripContactTelephone String?
  tripContactEmail     String?
  notes                String?
  requestSource        String?
  status               String
  createdAt            DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(6)
  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer             Customer                     @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  statusHistory        RentalRequestStatusHistory[]
  pricingWorksheets    RentalPricingWorksheet[]

  @@unique([companyId, id])
  @@index([companyId, status, createdAt])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, serviceDate])
}

model RentalRequestStatusHistory {
  id          String        @id @default(cuid())
  companyId   String
  requestId   String
  actorId     String
  fromStatus  String?
  toStatus    String
  reason      String
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  request     RentalRequest @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)
  actor       User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, requestId, createdAt])
}

model RentalPricingWorksheet {
  id                     String        @id @default(cuid())
  companyId              String
  requestId              String
  version                Int
  createdById            String
  lines                  Json
  preTaxSubtotalPesewas  BigInt
  distanceMetres         Int?
  durationMinutes        Int?
  reason                 String        @db.VarChar(500)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  request                RentalRequest @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)
  createdBy              User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, requestId, version])
  @@index([companyId, requestId, createdAt])
}

model VehicleSafetyBlock {
  id                 String    @id @default(cuid())
  companyId          String
  vehicleId          String
  status              String
  reason              String    @db.VarChar(500)
  appliedById         String
  appliedAt           DateTime  @default(now()) @db.Timestamptz(6)
  releasedById        String?
  releasedAt          DateTime? @db.Timestamptz(6)
  releaseReason       String?   @db.VarChar(500)
  workCompletedAt     DateTime? @db.Timestamptz(6)
  inspectionResults   String?
  inspectionPassed    Boolean?
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle             Vehicle   @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  appliedBy           User      @relation("SafetyBlockAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  releasedBy          User?     @relation("SafetyBlockReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([companyId, vehicleId, appliedAt])
}

model MaintenanceWorkOrderStatusHistory {
  id           String              @id @default(cuid())
  companyId    String
  workOrderId  String
  sequence     Int
  actorId      String
  fromStatus   String?
  toStatus     String
  reason       String              @db.VarChar(500)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workOrder    MaintenanceWorkOrder @relation(fields: [companyId, workOrderId], references: [companyId, id], onDelete: Restrict)
  actor        User                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, workOrderId, sequence])
  @@index([companyId, workOrderId, createdAt])
}

model MaintenanceWorkOrder {
  id                   String    @id @default(cuid())
  companyId            String
  vehicleId            String
  reference            String    @db.VarChar(32)
  reportedFault        String    @db.VarChar(2000)
  workType             String?   @db.VarChar(120)
  priority             String?   @db.VarChar(40)
  dateReported         DateTime  @db.Date
  odometerValue        Decimal?  @db.Decimal(12, 2)
  odometerUnit         String?
  safetyRelated        Boolean
  requiredWork         String?
  parts                String?
  labourCostPesewas   BigInt?
  partsCostPesewas    BigInt?
  otherCostPesewas    BigInt?
  inspectionResults   String?
  completionDate       DateTime? @db.Timestamptz(6)
  status               String    @default("Reported")
  reason               String    @db.VarChar(500)
  createdById          String
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle              Vehicle   @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  createdBy            User      @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  statusHistory        MaintenanceWorkOrderStatusHistory[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, status, dateReported])
  @@index([companyId, vehicleId, dateReported])
}

model Booking {
  id               String    @id @default(cuid())
  companyId        String
  clientId         String
  employeeId       String
  contractId       String?
  routeId          String?
  tripId           String?
  reference        String
  bookingType      String
  journeyDate      DateTime  @db.Date
  pickupLocationId String?
  dropoffLocationId String?
  notes            String?
  status           String
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client           Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  employee         Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  contract         Contract? @relation(fields: [companyId, contractId], references: [companyId, id], onDelete: Restrict)
  route            Route?    @relation(fields: [companyId, routeId], references: [companyId, id], onDelete: Restrict)
  trip             Trip?     @relation(fields: [companyId, tripId], references: [companyId, id], onDelete: Restrict)
  pickupLocation   Location? @relation("BookingPickup", fields: [companyId, pickupLocationId], references: [companyId, id], onDelete: Restrict)
  dropoffLocation  Location? @relation("BookingDropoff", fields: [companyId, dropoffLocationId], references: [companyId, id], onDelete: Restrict)
  statusHistory    BookingStatusHistory[]
  passengerFeedback PassengerFeedback[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, status, journeyDate])
  @@index([companyId, employeeId, journeyDate])
  @@index([companyId, clientId, journeyDate])
  @@index([companyId, tripId])
}

model BookingStatusHistory {
  id         String   @id @default(cuid())
  companyId  String
  bookingId  String
  sequence   Int
  actorId    String
  fromStatus String?
  toStatus   String
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  booking    Booking  @relation(fields: [companyId, bookingId], references: [companyId, id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, bookingId, sequence])
  @@index([companyId, bookingId, createdAt])
}

model DriverEvent {
  id             String   @id @default(cuid())
  companyId      String
  tripId         String
  driverId       String
  actorId        String
  idempotencyKey String
  eventType      String
  summary        Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  trip           Trip     @relation(fields: [companyId, tripId], references: [companyId, id], onDelete: Restrict)
  driver         Driver   @relation(fields: [companyId, driverId], references: [companyId, id], onDelete: Restrict)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, tripId, idempotencyKey])
  @@index([companyId, driverId, createdAt])
}

model CorporateInvoice {
  id             String   @id @default(cuid())
  companyId      String
  clientId       String
  contractId     String
  reference      String
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  status         String
  subtotalPesewas Int
  taxPesewas     Int
  totalPesewas   Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client         Client   @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  contract       Contract @relation(fields: [companyId, contractId], references: [companyId, id], onDelete: Restrict)
  lines          CorporateInvoiceLine[]
  statusHistory  CorporateInvoiceStatusHistory[]
  payments       InvoicePayment[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@unique([companyId, contractId, periodStart, periodEnd])
  @@index([companyId, clientId, periodStart])
}

model CorporateInvoiceLine {
  id              String   @id @default(cuid())
  companyId       String
  invoiceId       String
  tripId          String?
  description     String
  unit            String
  quantity        Int
  ratePesewas     Int
  amountPesewas   Int
  // Maintained only by database triggers: true while the parent invoice is
  // not VOID. The status-aware trip-billing freeze is a partial unique index
  // on (companyId, tripId) WHERE billingActive (migration-only; Prisma cannot
  // express partial indexes).
  billingActive   Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  invoice         CorporateInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  trip            Trip?    @relation(fields: [companyId, tripId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, invoiceId])
}

model CorporateInvoiceStatusHistory {
  id         String   @id @default(cuid())
  companyId  String
  invoiceId  String
  sequence   Int
  actorId    String
  fromStatus String?
  toStatus   String
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  invoice    CorporateInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, invoiceId, sequence])
  @@index([companyId, invoiceId, createdAt])
}

model InvoicePayment {
  id            String   @id @default(cuid())
  companyId     String
  invoiceId     String
  amountPesewas Int
  method        String?
  reference     String?
  receivedAt    DateTime @db.Date
  reason        String
  recordedById  String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  invoice       CorporateInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  recordedBy    User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([companyId, invoiceId, createdAt])
}

model PassengerFeedback {
  id        String   @id @default(cuid())
  companyId String
  bookingId String
  employeeId String
  rating    Int?
  comment   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  booking   Booking  @relation(fields: [companyId, bookingId], references: [companyId, id], onDelete: Restrict)
  employee  Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, bookingId])
  @@index([companyId, employeeId, createdAt])
}

model UserClientBinding {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  clientId  String
  reason    String
  boundById String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User      @relation("BindingUser", fields: [userId], references: [id], onDelete: Restrict)
  client    Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  boundBy   User      @relation("BindingActor", fields: [boundById], references: [id], onDelete: Restrict)

  @@index([companyId, userId, revokedAt])
  @@index([companyId, clientId, revokedAt])
}

model Trip {
  id                     String    @id @default(cuid())
  companyId              String
  clientId               String?
  routeId                String?
  scheduleId             String?
  reference              String
  serviceType            String?
  tripDate               DateTime  @db.Date
  plannedStartTime       String?
  plannedDurationMinutes Int?
  capacityLimit          Int?
  vehicleId              String?
  driverId               String?
  status                 String
  delayReason            String?
  completionNotes        String?
  actualStartAt          DateTime? @db.Timestamptz(6)
  actualEndAt            DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                 Client?   @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  route                  Route?    @relation(fields: [companyId, routeId], references: [companyId, id], onDelete: Restrict)
  schedule               RouteSchedule? @relation(fields: [companyId, scheduleId], references: [companyId, id], onDelete: Restrict)
  vehicle                Vehicle?  @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  driver                 Driver?   @relation(fields: [companyId, driverId], references: [companyId, id], onDelete: Restrict)
  bookings               Booking[]
  statusHistory          TripStatusHistory[]
  driverEvents           DriverEvent[]
  invoiceLines           CorporateInvoiceLine[]
  incidents              Incident[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, status, tripDate])
  @@index([companyId, routeId, tripDate])
  @@index([companyId, driverId, tripDate])
}

model TripStatusHistory {
  id         String   @id @default(cuid())
  companyId  String
  tripId     String
  sequence   Int
  actorId    String
  fromStatus String?
  toStatus   String
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  trip       Trip     @relation(fields: [companyId, tripId], references: [companyId, id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, tripId, sequence])
  @@index([companyId, tripId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  channel   String    @default("IN_APP")
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(1000)
  entityType String?  @db.VarChar(64)
  entityId   String?
  dedupeKey String    @db.VarChar(200)
  status    String    @default("DELIVERED")
  destination String? @db.VarChar(254)
  providerMessageId String? @db.VarChar(128)
  attempts  Int       @default(0)
  lastError String?   @db.VarChar(500)
  nextAttemptAt DateTime? @db.Timestamptz(6)
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId, channel, dedupeKey])
  @@index([companyId, userId, readAt, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([channel, status, nextAttemptAt])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  inAppEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
}

model Incident {
  id                  String    @id @default(cuid())
  companyId           String
  reference           String
  incidentType        String    @db.VarChar(32)
  severity            String    @db.VarChar(16)
  status              String    @default("Open")
  tripId              String?
  vehicleId           String?
  driverId            String?
  occurredAt          DateTime  @db.Timestamptz(6)
  locationText        String?   @db.VarChar(300)
  description         String    @db.VarChar(2000)
  peopleAffected      String?   @db.VarChar(1000)
  immediateAction     String?   @db.VarChar(1000)
  reportedById        String
  assignedResponderId String?
  resolutionNotes     String?   @db.VarChar(2000)
  resolvedAt          DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  trip                Trip?     @relation(fields: [companyId, tripId], references: [companyId, id], onDelete: Restrict)
  vehicle             Vehicle?  @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  driver              Driver?   @relation(fields: [companyId, driverId], references: [companyId, id], onDelete: Restrict)
  reportedBy          User      @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedResponder   User?     @relation("IncidentResponder", fields: [assignedResponderId], references: [id], onDelete: Restrict)
  statusHistory       IncidentStatusHistory[]

  @@unique([companyId, id])
  @@unique([companyId, reference])
  @@index([companyId, status, occurredAt])
  @@index([companyId, tripId])
  @@index([companyId, vehicleId])
}

model IncidentStatusHistory {
  id         String   @id @default(cuid())
  companyId  String
  incidentId String
  sequence   Int
  actorId    String
  fromStatus String?
  toStatus   String
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  incident   Incident @relation(fields: [companyId, incidentId], references: [companyId, id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, incidentId, sequence])
  @@index([companyId, incidentId, sequence])
}
