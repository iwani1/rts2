DATABASE_URL="postgresql://tms:tms_local_only@localhost:5432/richie_tms?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
APP_URL="http://localhost:3000"

# SMS notifications (NTF-02, optional). Without these, SMS stays "Not configured"
# and nothing is sent; in-app notifications work regardless.
SMS_PROVIDER=""
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID=""
SMS_WEBHOOK_SECRET=""

# Email notifications (NTF-03, optional). Without these, email stays
# "Not configured"; in-app (and SMS, if set) work regardless.
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
